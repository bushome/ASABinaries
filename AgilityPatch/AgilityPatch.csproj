<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AgilityPatch</AssemblyName>
    <RootNamespace>AgilityPatch</RootNamespace>
    <Version>1.0.0</Version>
    <Product>AgilityPatch</Product>
    <Description>Sets an exe's D3D12SDKVersion to match the Agility SDK D3D12Core.dll it loads.</Description>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Native AOT: one small exe, no .NET runtime needed on the player's PC.
         Needs the MSVC C++ build tools (VS "Game development with C++" has them). -->
    <PublishAot>true</PublishAot>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
